<?xml version="1.0" encoding="utf-8"?>
<!--
    O catalogo do usuario pode vir do PC dele na rede local (http://192.168.x.x)
    e esse endereco e configuravel em Ajustes — nao da para fixar o host aqui.

    Por isso o cleartext e permitido: a integridade nao depende do transporte.
    O catalogo e assinado com Ed25519 (ver CatalogVerifier) e cada download so
    entra na biblioteca se o SHA-256 bater (ver RomDownloader). HTTPS continua
    sendo usado quando o servidor oferece.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
