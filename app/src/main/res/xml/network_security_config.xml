<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS obrigatorio para catalogo, downloads e capas.

    A unica excecao e o servidor de desenvolvimento local (adb reverse usa
    127.0.0.1; o emulador Android usa 10.0.2.2). Sem isso nao da para testar o
    downloader com um servidor HTTP sem colocar o app em modo inseguro.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
